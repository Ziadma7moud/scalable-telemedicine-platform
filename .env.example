# Application environment (development | production)
NODE_ENV=development

# PostgreSQL container credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=app_db

# PostgreSQL Database Connection
# Must match the POSTGRES_* values above.
# Inside Docker Compose, replace 127.0.0.1 with the database service name.
DATABASE_URL=postgresql://postgres:change-this-password@127.0.0.1:5432/app_db

# Secret used to sign and verify JWT tokens
JWT_SECRET=change-this-to-a-secure-random-string

# Seed API secret, sent in the x-seed-secret header (seeding works in development only)
SEED_SECRET=change-this-to-a-secure-random-string
